import sqlite3

def getData():
    connect = sqlite3.connect('dog_data.db')
    cursor = connect.cursor()
    cursor.execute('''
        CREATE TABLE dog(
        id INTEGER PRIMARY KEY,
        breed TEXT,
        image_url TEXT    
        )    ''')


    connect.commit()
    connect.close()


